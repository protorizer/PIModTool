<SyntaxDefinition name="EventScript" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground = "Green"/>
	<Color name="String" foreground = "Teal"/>
	<Color name="Number" foreground = "Orange"/>
	<Color name="PropertyKeyword" foreground="#007ACC" fontWeight="bold"/>
    <Color name="BlockKeyword" foreground = "Red" fontWeight = "bold"/>
	

	<RuleSet>
		<Span color="Comment" begin="//" />
        <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
        <Span color="String">
            <Begin>"</Begin>
            <End>"</End>
            <RuleSet>
                <!-- nested span for escape sequences -->
                <Span begin="\\" end="." />
            </RuleSet>
        </Span>

        <!-- Begin and End block highlighting -->
        <Rule color="BlockKeyword">
    		^\s*(Begin)(?=\s+[A-Za-z0-9_]+\s*$)|^\s*(End)\s*$
  		</Rule>

        <!-- PropertyName Highlighting -->
        <Rule color="PropertyKeyword">
            (?&lt;=^\s*Begin\s+)[A-Za-z0-9_]+
        </Rule>

        <!-- Digits -->
        <Rule color="Number">
            \b0[xX][0-9a-fA-F]+  # hex number
        |    \b
            (    \d+(\.[0-9]+)?   #number with optional floating point
            |    \.[0-9]+         #or just starting with floating point
            )
            ([eE][+-]?[0-9]+)? # optional exponent
        </Rule>

	</RuleSet>
</SyntaxDefinition>