<Window x:Class="PIModTool.Wpf.Views.Components.SmallFEditorNewFilePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PIModTool.Wpf.Views.Components"
        mc:Ignorable="d"
        Title="World's Strongest Popup Box 3.0" Height="450" Width="800" Background="#444444">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="New File" HorizontalAlignment="Center" FontSize="30" Foreground="LightGray"/>
            <TextBox x:Name="FileNameBox"
                     Text="{Binding FileName, Mode=TwoWay}"
                     Background="#303030"
                     BorderBrush="Gray"
                     BorderThickness="1"
                     Foreground="White"
                     Margin="0,2,0,8"
                     Padding="4"/>
            <ComboBox x:Name="FileTypeBox"
                      Margin="0,2,0,8"
                      Padding="4"
                      ItemsSource="{Binding FileTypes}"
                      SelectedItem="{Binding FileType, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="Create"
                        Width="150"
                        Height="100"
                        Background="DarkGray"
            Margin="20,10,20,0"
            Click="Create_Click"/>      
                <Button Content="Cancel"
        Width="150"
        Margin="20,10,20,0"
                        Background="DarkGray"
        Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="This window brought to you by Saymer Industries™. Creating rugged popups built for utility rather than looks since 2006!" Foreground="White" HorizontalAlignment="Right"/>
    </Grid>
</Window>
