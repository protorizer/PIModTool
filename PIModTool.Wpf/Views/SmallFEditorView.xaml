<views:MvxWpfView
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:mvx="clr-namespace:MvvmCross.Platforms.Wpf.Binding;assembly=MvvmCross.Platforms.Wpf"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    x:Class="PIModTool.Wpf.Views.SmallFEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PIModTool.Wpf.Views"
             xmlns:utilities="clr-namespace:PIModTool.Wpf.Utilities"
             xmlns:components="clr-namespace:PIModTool.Wpf.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="BackButton_OnClick">Back to Dashboard</Button>
            <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="ExportFilesButton_OnClick">Export All Files</Button>
            <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="SaveSmallFButton_OnClick">Save SmallF.dat</Button>
        </StackPanel>
        <Border Grid.Row="2" Grid.Column="1" BorderBrush="DarkGray" BorderThickness="1">
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Width="200" ItemsSource="{Binding Files}" SelectedItem="{Binding ActiveFile, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Foreground="LightGray">
                <ListBox.Resources>
                    <ContextMenu x:Key="FileContextMenu">
                        <MenuItem Header="New File..."
      Command="{Binding DataContext.CreateNewFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Separator/>
                        <MenuItem Header="Rename"
      Command="{Binding DataContext.BeginRenameCommand,
                        RelativeSource={RelativeSource AncestorType=ListBox}}"
      CommandParameter="{Binding}" />
                        <MenuItem Header="Export Selected File"
      Command="{Binding DataContext.ExportFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
      CommandParameter="{Binding}"/>
                    </ContextMenu>
                </ListBox.Resources>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu"
    Value="{StaticResource FileContextMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="4,2">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource FileRenameVisibilityMultiConverter}" ConverterParameter="Display">
                                        <Binding Path="DataContext.RenamingFile" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        <Binding Path="." />
                                        <!-- current item -->
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="#202020"
                     Foreground="LightGray"
                     BorderThickness="1"
                     BorderBrush="DarkGray"
                     Padding="1"
                     KeyDown="FileNameTextBox_KeyDown"
                     LostFocus="FileNameTextBox_LostFocus"
                     Loaded="FileNameTextBox_Loaded">
                                <TextBox.Visibility>
                                    <MultiBinding Converter="{StaticResource FileRenameVisibilityMultiConverter}" ConverterParameter="Edit">
                                        <Binding Path="DataContext.RenamingFile" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        <Binding Path="." />
                                        <!-- current item -->
                                    </MultiBinding>
                                </TextBox.Visibility>
                            </TextBox>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" BorderBrush="DarkGray" BorderThickness="1">
            <avalonEdit:TextEditor Name="PSCEditor" ShowLineNumbers="True" Padding="0,0,10,0" FontFamily="Consolas" FontSize="14" WordWrap="True" Document="{Binding EditorDocument, Mode=TwoWay}" utilities:SyntaxHighlightingUtilities.BindHighlighting="{Binding ActiveFileType}" utilities:CodeFoldingUtilities.BindCodeFolding="{Binding ActiveFileType}"  Background="Transparent" Foreground="LightGray">
                <avalonEdit:TextEditor.Resources>

                    <Style TargetType="{x:Type avalonEdit:DropDownButton}">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#000033"/>
                    </Style>

                    <!-- Search textbox -->
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Foreground" Value="#D4D4D4"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="4"/>
                    </Style>

                    <!-- Search buttons -->
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#000033"/>
                        <Setter Property="Foreground" Value="#D4D4D4"/>
                        <Setter Property="BorderBrush" Value="Navy"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>

                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>

                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}"/>

                </avalonEdit:TextEditor.Resources>
            </avalonEdit:TextEditor>
        </Border>
    </Grid>
</views:MvxWpfView>
