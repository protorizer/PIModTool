<views:MvxWpfView
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:mvx="clr-namespace:MvvmCross.Platforms.Wpf.Binding;assembly=MvvmCross.Platforms.Wpf"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    x:Class="PIModTool.Wpf.Views.YukEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PIModTool.Wpf.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:components="clr-namespace:PIModTool.Wpf.Views.Components"
             xmlns:utilities="clr-namespace:PIModTool.Wpf.Utilities"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <views:MvxWpfView.Resources>
        <sys:Double x:Key="StemBoxWidth">275</sys:Double>
        <sys:Double x:Key="StemBoxHeight">100</sys:Double>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" True="Visible" False="Collapsed"/>
        <utilities:BooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" True="Collapsed" False="Visible"/>
    </views:MvxWpfView.Resources>

    <Grid>
        <local:LoadingView Message="{Binding LoadingScreenMessage}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}}" d:Visibility="Collapsed"/>
        <Grid Visibility="{Binding Busy, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="25" Width="150" Style="{StaticResource CustomButtonStyle}" Command="{Binding BackButtonCommand}">Back to Dashboard</Button>
                    <Button Grid.Column="2" Height="25" Width="200" Margin="0,0,10,0" Style="{StaticResource CustomButtonStyle}" Command="{Binding ExportWavCommand}">Export stems to .wav</Button>
                    <Button Grid.Column="3" Height="25" Width="200" Style="{StaticResource CustomButtonStyle}" Command="{Binding SaveYukCommand}">Save as .yuk</Button>
            </Grid>
           

            <!-- Use Visibility="Hidden" to hide elements, IsHitTestVisible="False" to make non-interactible -->

            <components:MenuBoxView Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Label="Stem Sources" HeaderPadding="5" Margin="0,0,0,5">
                <Grid>
                    <StackPanel Visibility="{Binding StemSelectorActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" d:Visibility="Hidden">
                        <Button Height="75" Width="200" Style="{StaticResource CustomButtonStyle}" Margin="0,0,215,0" Command="{Binding NewYukCommand}">Create New .yuk</Button>
                        <Button Height="75" Width="200" Style="{StaticResource CustomButtonStyle}" Margin="215,0,0,0" Command="{Binding OpenYukCommand}">Open Existing .yuk</Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding StemPickers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid Visibility="{Binding StemSelectorActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                <Setter Property="Grid.Column" Value="{Binding Column}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <components:MenuBoxView
                                    Height="{StaticResource StemBoxHeight}"
                                    Width="{StaticResource StemBoxWidth}"
                                    Label="{Binding Label}"
                                    HeaderPadding="5">

                                    <components:AudioStemView />
                                </components:MenuBoxView>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </components:MenuBoxView>

            <components:MenuBoxView Grid.Row="3" Grid.Column="1" Label="Stem Mixing" HeaderPadding="5" Margin="0,5,5,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding AmpMetadataSelected, Converter={StaticResource InverseBoolToVisibilityConverter}}" d:Visibility="Collapsed" >
                        <TextBlock Margin="50,0,50,0" Text="You must open SmallF.dat to edit song information and dynamic mixing levels." Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button Height="75" Width="200" Style="{StaticResource CustomButtonStyle}" Margin="0,20,0,0" Command="{Binding OpenAmpCommand}">Open File</Button>
                    </StackPanel>
                    <StackPanel Visibility="{Binding AmpMetadataSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text=".yuk Filename" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <TextBox Text="{Binding FileName}" Width="175" TextAlignment="Center" Background="#202020" Foreground="LightGray" BorderThickness="1" BorderBrush="DarkGray" Padding="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="Song Title" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <TextBox Text="{Binding SongTitle}" Width="175" TextAlignment="Center" Background="#202020" Foreground="LightGray" BorderThickness="1" BorderBrush="DarkGray" Padding="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Vertical">
                                <TextBlock Text="Artist Name" Margin="0,0,0,10" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <TextBox Text="{Binding ArtistName}" Width="175" TextAlignment="Center" Background="#202020" Foreground="LightGray" BorderThickness="1" BorderBrush="DarkGray" Padding="1"/>
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Height="25" Width="200" Margin="0,10,75,0" Command="{Binding FetchSongDetailsCommand}" Style="{StaticResource CustomButtonStyle}">Load Existing Values</Button>
                            <Button Height="25" Width="200" Margin="0,10,0,0" Command="{Binding SaveSongDetailsCommand}" Style="{StaticResource CustomButtonStyle}">Save to SmallF.dat</Button>
                        </StackPanel>
                        <Separator Background="SlateGray" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Width="250" Orientation="Vertical" Margin="0,0,50,0">
                                <TextBlock Text="{Binding Path=MixVolumes[0], StringFormat=In The Pack Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[0]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="{Binding Path=MixVolumes[1], StringFormat=Takedown Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[1]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="{Binding Path=MixVolumes[2], StringFormat=Ultimate Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[2]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="{Binding Path=MixVolumes[3], StringFormat=Unwreck Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[3]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                            </StackPanel>
                            <StackPanel Width="250" Orientation="Vertical">
                                <TextBlock Text="{Binding Path=MixVolumes[4], StringFormat=Boost Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[4]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="{Binding Path=MixVolumes[5], StringFormat=First Place Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[5]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="{Binding Path=MixVolumes[6], StringFormat=Shields Down Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[6]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="{Binding Path=MixVolumes[7], StringFormat=Left Behind Volume: {0:P2}}" Margin="0,10,0,0" Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                                <Slider Value="{Binding MixVolumes[7]}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </components:MenuBoxView>

            <components:MenuBoxView Grid.Row="3" Grid.Column="2" Label="Mixing Preview" HeaderPadding="5" Margin="5,5,0,0">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Height="50" Width="150" Margin="0,0,150,0" PreviewMouseLeftButtonDown="StartUnwreck" PreviewMouseLeftButtonUp="EndUnwreck" Style="{StaticResource CustomButtonStyle}">Hold to Unwreck</Button>
                        <Button Height="50" Width="150" PreviewMouseLeftButtonDown="StartBoost" PreviewMouseLeftButtonUp="EndBoost" Style="{StaticResource CustomButtonStyle}">Hold to Boost</Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Height="50" Width="100" Command="{Binding ChangePreviewStemCommand}" CommandParameter="2" Style="{StaticResource CustomButtonStyle}">Ultimate</Button>
                        <Button Height="50" Width="100" Command="{Binding ChangePreviewStemCommand}" CommandParameter="1" Style="{StaticResource CustomButtonStyle}">Takedown</Button>
                        <Button Height="50" Width="100" Command="{Binding ChangePreviewStemCommand}" CommandParameter="6" Style="{StaticResource CustomButtonStyle}">Shields Down</Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Height="50" Width="100" Command="{Binding ChangePreviewStemCommand}" CommandParameter="5" Style="{StaticResource CustomButtonStyle}">First Place</Button>
                        <Button Height="50" Width="100" Command="{Binding ChangePreviewStemCommand}" CommandParameter="0" Style="{StaticResource CustomButtonStyle}">In The Pack</Button>
                        <Button Height="50" Width="100" Command="{Binding ChangePreviewStemCommand}" CommandParameter="7" Style="{StaticResource CustomButtonStyle}">Left Behind</Button>
                    </StackPanel>

                    <Slider Value="{Binding PlaybackProgress, Mode=TwoWay}" PreviewMouseDown="Scrubber_MouseDown" PreviewMouseUp="Scrubber_MouseUp" Margin="0,20,0,0" IsMoveToPointEnabled="True" Minimum="0" Maximum="1"/>
                    <TextBlock Text="{Binding TimeText}"  Foreground="White" HorizontalAlignment="Center" FontFamily="pack://application:,,,/Resources/Fonts/#Euromode"/>
                    <Button Height="35" Width="100" Margin="0,10,0,0" Command="{Binding TogglePreviewsCommand}" Click="StartPlaybackTimer" Style="{StaticResource CustomButtonStyle}">Play/Pause</Button>
                </StackPanel>
                
            </components:MenuBoxView>
            
        </Grid>
    </Grid>
</views:MvxWpfView>
