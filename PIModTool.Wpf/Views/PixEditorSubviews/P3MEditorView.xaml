<views:MvxWpfView
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:mvx="clr-namespace:MvvmCross.Platforms.Wpf.Binding;assembly=MvvmCross.Platforms.Wpf"
    xmlns:viewModels="clr-namespace:PIModTool.Core.ViewModels.PixEditorSubviews;assembly=PIModTool.Core"
    x:Class="PIModTool.Wpf.Views.PixEditorSubviews.P3MEditorView"
    x:TypeArguments="viewModels:P3MEditorViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:helix="http://helix-toolkit.org/wpf"
      xmlns:local="clr-namespace:PIModTool.Wpf.Views.PixEditorSubviews"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280">

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image Source="{Binding ActiveTexture, Converter={StaticResource BinaryToBitmapConverter}}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </ScrollViewer>
    </Grid>
</views:MvxWpfView>
