<views:MvxWpfView
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:mvx="clr-namespace:MvvmCross.Platforms.Wpf.Binding;assembly=MvvmCross.Platforms.Wpf"
    xmlns:viewModels="clr-namespace:PIModTool.Core.ViewModels;assembly=PIModTool.Core"
    xmlns:subViewModels="clr-namespace:PIModTool.Core.ViewModels.PixEditorSubviews;assembly=PIModTool.Core"
    xmlns:subViews="clr-namespace:PIModTool.Wpf.Views.PixEditorSubviews"
    x:Class="PIModTool.Wpf.Views.PixEditorView"
    x:TypeArguments="viewModels:PixEditorViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PIModTool.Wpf.Views"
      xmlns:components="clr-namespace:PIModTool.Wpf.Views.Components"
      xmlns:utilities="clr-namespace:PIModTool.Wpf.Utilities"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280">

    <views:MvxWpfView.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" True="Visible" False="Collapsed"/>
        <utilities:BooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" True="Collapsed" False="Visible"/>

        <!-- Datatemplate for subviews -->
        <DataTemplate DataType="{x:Type subViewModels:DRPEditorViewModel}">
            <subViews:DRPEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type subViewModels:TextureEditorViewModel}">
            <subViews:TextureEditorView />
        </DataTemplate>
    </views:MvxWpfView.Resources>

    <Grid>
        <local:LoadingView Message="{Binding LoadingScreenMessage}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}}" d:Visibility="Collapsed"/>
        <Grid Visibility="{Binding Busy, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Orientation="Vertical">
                <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="BackButton_OnClick">Back to Dashboard</Button>
                <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="SavePixButton_OnClick">Save .pix File</Button>
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="3" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Height="25" Margin="0,0,0,5" ItemsSource="{Binding Editors}" SelectedItem="{Binding SelectedEditor, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding LoadedFiles}" Text="Select Editor..." Foreground="LightGray"/>
                <Button Grid.Column="2" Height="25" Width="200" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Command="{Binding ExportDataCommand}">Export File</Button>
            </Grid>
            <Border Grid.Row="3" Grid.Column="1" BorderBrush="DarkGray" BorderThickness="1">
                <components:FileTreeNodeView Width="200" Files="{Binding DisplayedFiles}" SelectedFile="{Binding ActiveFile, Mode=TwoWay}" EnableRename="False"/>
            </Border>

            <Border Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" BorderBrush="DarkGray" BorderThickness="1">
                <Grid>
                    <Button Width="200" Height="75" Command="{Binding OpenPixCommand}" Visibility="{Binding LoadedFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}" Style="{StaticResource CustomButtonStyle}">Select a .pix file</Button>
                    <ContentControl Content="{Binding ActiveSubViewModel}" Visibility="{Binding HasActiveSubView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</views:MvxWpfView>
