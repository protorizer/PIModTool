<views:MvxWpfView
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    xmlns:mvx="clr-namespace:MvvmCross.Platforms.Wpf.Binding;assembly=MvvmCross.Platforms.Wpf"
    xmlns:viewModels="clr-namespace:PIModTool.Core.ViewModels;assembly=PIModTool.Core"
    x:Class="PIModTool.Wpf.Views.PixEditorView"
    x:TypeArguments="viewModels:PixEditorViewModel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PIModTool.Wpf.Views"
      xmlns:utilities="clr-namespace:PIModTool.Wpf.Utilities"
      xmlns:helix="http://helix-toolkit.org/wpf"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280">

    <views:MvxWpfView.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" True="Visible" False="Collapsed"/>
        <utilities:BooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" True="Collapsed" False="Visible"/>
    </views:MvxWpfView.Resources>

    <Grid>
        <local:LoadingView Message="{Binding LoadingScreenMessage}" Visibility="{Binding Busy, Converter={StaticResource BoolToVisibilityConverter}}" d:Visibility="Collapsed"/>
        <Grid Visibility="{Binding Busy, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="BackButton_OnClick">Back to Dashboard</Button>
                <Button Height="25" Style="{StaticResource CustomButtonStyle}" Margin="0,0,0,5" Click="ExportObjButton_OnClick">Export Selected File</Button>
            </StackPanel>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="DarkGray" BorderThickness="1">
                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Width="200" ItemsSource="{Binding PixFiles}" SelectedItem="{Binding ActiveFile, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Foreground="LightGray">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="4,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" BorderBrush="DarkGray" BorderThickness="1">
                <Grid>
                    <Button Width="200" Height="75" Command="{Binding OpenPixCommand}" Visibility="{Binding LoadedFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}" Style="{StaticResource CustomButtonStyle}">Select a .pix file</Button>
                    <helix:HelixViewport3D Visibility="{Binding LoadedFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                        <helix:SunLight/>
                        <!-- <helix:PointsVisual3D x:Name="MeshPoints" Color="Red" Size="2"/> -->
                        <ModelVisual3D x:Name="MeshViewer"/>
                    </helix:HelixViewport3D>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</views:MvxWpfView>
