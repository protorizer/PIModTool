<views:MvxWindow 
    xmlns:views="clr-namespace:MvvmCross.Platforms.Wpf.Views;assembly=MvvmCross.Platforms.Wpf"
    x:Class="PIModTool.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PIModTool.Wpf"
        mc:Ignorable="d"
        Title="PIModTool" Height="720" Width="1280">
    <views:MvxWindow.Icon>
        <BitmapImage UriSource="pack://application:,,,/Resources/Images/PIIcon.png"/>
    </views:MvxWindow.Icon>
    <Window.Background>
        <RadialGradientBrush>
            <!-- Center of the gradient -->
            <RadialGradientBrush.Center>
                <Point X="0" Y="0"/>
                <!-- Bottom-right corner -->
            </RadialGradientBrush.Center>
            <RadialGradientBrush.GradientOrigin>
                <Point X="0" Y="0"/>
                <!-- Origin of the gradient (bottom-right corner) -->
            </RadialGradientBrush.GradientOrigin>
            <RadialGradientBrush.RadiusX>1.75</RadialGradientBrush.RadiusX>
            <RadialGradientBrush.RadiusY>1.5</RadialGradientBrush.RadiusY>

            <!-- Gradient Stops -->
            <GradientStop Color="Black" Offset="0.0" />
            <GradientStop Color="Black" Offset="0.5" />
            <!-- Strong blue at the center -->
            <GradientStop Color="DarkBlue" Offset="1.0" />
            <!-- Transparent towards edges -->
        </RadialGradientBrush>
    </Window.Background>

    <!-- USED FOR PROMOTIONAL SCREENSHOTS -->
    <Window.InputBindings>
        <KeyBinding
        Key="S"
        Modifiers="Ctrl+Shift"
        Command="{Binding CaptureScreenshotCommand}" />
    </Window.InputBindings>


    <Grid>

    </Grid>
</views:MvxWindow>
